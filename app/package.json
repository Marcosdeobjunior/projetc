    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-collaboration": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/suggestion": "^3.32.1",
    "@tiptap/y-tiptap": "^3.0.11",
    "d3-force": "^3.0.0",
    "docx": "^9.15.0",
    "fflate": "^0.8.3",
